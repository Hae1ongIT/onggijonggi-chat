{
  "settings": {
    "analysis": {
      "analyzer": {
        "korean": {
          "type": "custom",
          "tokenizer": "nori_tokenizer",
          "filter": ["nori_part_of_speech", "nori_readingform", "lowercase"]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "chunk_id": { "type": "keyword" },
      "doc_id": { "type": "keyword" },
      "thr_id": { "type": "keyword" },
      "tnn_id": { "type": "keyword" },
      "run_seq": { "type": "integer" },
      "seq": { "type": "integer" },
      "content": { "type": "text", "analyzer": "korean" },
      "loc": { "type": "keyword" },
      "emb": {
        "type": "dense_vector", "dims": 1024, "index": true, "similarity": "cosine",
        "index_options": { "type": "bbq_hnsw", "m": 16, "ef_construction": 100, "rescore_vector": { "oversample": 3.0 } }
      },
      "emb_mdl": { "type": "keyword" }
    }
  }
}
